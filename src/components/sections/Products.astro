---
// src/components/sections/Products.astro
---

<section id="productos" class="relative py-24 md:py-32 ds-reveal bg-[var(--ds-bg)] border-t border-[var(--ds-border)]">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 md:mb-20">
      <span class="text-xs font-semibold tracking-[0.15em] text-[var(--ds-accent)] uppercase">
        PRODUCTO PROPIO · INFRAESTRUCTURA FINANCIERA
      </span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-[var(--ds-text)] sm:text-4xl md:text-5xl leading-tight font-display">
        Donatio: Infraestructura financiera para fundaciones y ONGs
      </h2>
      <p class="mt-4 text-base md:text-lg leading-relaxed text-[var(--ds-muted)]">
        Recaudar fondos para tu causa no debería ser una batalla administrativa de llamar mes a mes a tus donantes, pedir fotos de transferencias por WhatsApp o sufrir el rechazo de tarjetas internacionales. Donatio conecta a tu fundación directamente con el sistema bancario.
      </p>
    </div>

    <!-- Main Showcase Container -->
    <div class="relative overflow-hidden rounded-3xl border border-[var(--ds-border)] bg-[var(--ds-surface)] p-8 md:p-12 lg:p-14 shadow-2xl transition-all duration-300">
      <!-- Ambient Glows -->
      <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-[var(--ds-accent)]/5 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-24 -bottom-24 h-96 w-96 rounded-full bg-[var(--ds-accent)]/5 blur-3xl" aria-hidden="true"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
        
        <!-- Left: Core Pitch & Pillars from Executive Video -->
        <div class="flex flex-col items-start lg:col-span-6">
          <!-- Badges -->
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-2 rounded-full border border-[var(--ds-accent)]/30 bg-[var(--ds-accent-dim)] px-3.5 py-1 text-xs font-semibold text-[var(--ds-accent)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--ds-accent)] animate-pulse" aria-hidden="true"></span>
              SaaS Insignia
            </span>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-[var(--ds-muted)]">
              Fintech Regulada · Bolivia & Internacional
            </span>
          </div>

          <!-- Pitch Headline -->
          <h3 class="mt-4 text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--ds-text)] font-display tracking-tight leading-snug">
            Hasta el 80% de donantes recurrentes se pierden por fricción administrativa
          </h3>

          <p class="mt-3 text-sm md:text-base text-[var(--ds-muted)] leading-relaxed">
            Las colectas tradicionales y transferencias manuales provocan inestabilidad financiera. Donatio convierte donaciones esporádicas en un flujo continuo de <strong class="text-white">socios padrinos con débito automático mensual</strong>, bajo tu propio subdominio y con blindaje legal total ante auditorías.
          </p>

          <div class="my-6 h-px w-full bg-[var(--ds-border)]"></div>

          <!-- The 4 Core Value Pillars from Pitch -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
            
            <!-- Pillar 1: Débito Automático Mensual -->
            <div class="rounded-xl border border-[var(--ds-border)] bg-[#07090C]/80 p-4 transition-colors hover:border-[var(--ds-accent)]/40">
              <div class="flex items-center gap-2.5 text-[var(--ds-accent)]">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <h4 class="text-xs font-bold uppercase tracking-wider text-white">Débito Mensual Automático</h4>
              </div>
              <p class="mt-2 text-xs text-[var(--ds-muted)] leading-relaxed">
                El donante ingresa su tarjeta una sola vez. El sistema realiza los cobros mes a mes automáticamente, reteniendo a tus padrinos sin llamadas de cobranza.
              </p>
            </div>

            <!-- Pillar 2: Pagos Globales y Nacionales -->
            <div class="rounded-xl border border-[var(--ds-border)] bg-[#07090C]/80 p-4 transition-colors hover:border-[var(--ds-accent)]/40">
              <div class="flex items-center gap-2.5 text-[var(--ds-accent)]">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h4 class="text-xs font-bold uppercase tracking-wider text-white">Pagos Globales en Bs. y USD</h4>
              </div>
              <p class="mt-2 text-xs text-[var(--ds-muted)] leading-relaxed">
                Recaudación activa 24/7 con tarjetas internacionales de crédito/débito y Códigos QR bancarios interbancarios en tiempo real para Bolivia.
              </p>
            </div>

            <!-- Pillar 3: Seguridad Bancaria 3DS2 -->
            <div class="rounded-xl border border-[var(--ds-border)] bg-[#07090C]/80 p-4 transition-colors hover:border-[var(--ds-accent)]/40">
              <div class="flex items-center gap-2.5 text-[var(--ds-accent)]">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <h4 class="text-xs font-bold uppercase tracking-wider text-white">Seguridad 3D Secure 2.0</h4>
              </div>
              <p class="mt-2 text-xs text-[var(--ds-muted)] leading-relaxed">
                Certificación Cybersource 3DS2 con verificación bancaria por SMS. Tokenización estricta: tu fundación nunca almacena números de tarjeta.
              </p>
            </div>

            <!-- Pillar 4: Cumplimiento UIF y Ley de Bancarización -->
            <div class="rounded-xl border border-[var(--ds-border)] bg-[#07090C]/80 p-4 transition-colors hover:border-[var(--ds-accent)]/40">
              <div class="flex items-center gap-2.5 text-[var(--ds-accent)]">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h4 class="text-xs font-bold uppercase tracking-wider text-white">Blindaje Legal UIF & ROE</h4>
              </div>
              <p class="mt-2 text-xs text-[var(--ds-muted)] leading-relaxed">
                Control de umbrales normativos (Ley 393 desde Bs. 3.500 y Ley 62 desde Bs. 50.000). Generación y exportación de reportes UIF-ROE en un clic.
              </p>
            </div>

          </div>

          <!-- Video Metrics Strip -->
          <div class="mt-6 grid grid-cols-3 gap-3 w-full rounded-xl border border-white/5 bg-[#0C0F12] p-4 text-center">
            <div>
              <span class="block text-xl md:text-2xl font-extrabold text-[var(--ds-accent)] font-mono">85%</span>
              <span class="block text-[10px] uppercase tracking-wider text-[var(--ds-muted)] mt-0.5">Menos tiempo administrativo</span>
            </div>
            <div class="border-x border-white/10">
              <span class="block text-xl md:text-2xl font-extrabold text-white font-mono">24/7</span>
              <span class="block text-[10px] uppercase tracking-wider text-[var(--ds-muted)] mt-0.5">Aportes del exterior</span>
            </div>
            <div>
              <span class="block text-xl md:text-2xl font-extrabold text-white font-mono">100%</span>
              <span class="block text-[10px] uppercase tracking-wider text-[var(--ds-muted)] mt-0.5">Aislamiento de datos</span>
            </div>
          </div>

          <!-- Real Client Endorsement -->
          <div class="mt-6 w-full rounded-xl border border-[var(--ds-border)] bg-[#07090C] p-4 text-xs leading-relaxed text-[var(--ds-muted)]">
            <span class="font-bold text-white uppercase tracking-wider block text-[11px] mb-1 text-[var(--ds-accent)]">
              Validado en Producción en Bolivia:
            </span>
            Implementado con éxito por la <strong class="text-white">Fundación Nuestra Esperanza</strong> (<a href="https://fundacion-nuestra-esperanza.cloud" target="_blank" rel="noopener noreferrer" class="text-[var(--ds-accent)] underline hover:opacity-80">fundacion-nuestra-esperanza.cloud</a>) para el financiamiento continuo y albergue de niños con cáncer en el Hospital del Niño de La Paz.
          </div>

          <!-- CTAs -->
          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full">
            <a
              href="https://donatio.darkosync.com"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--ds-accent)] px-7 py-3.5 text-sm font-bold text-black shadow-lg shadow-[var(--ds-accent)]/20 transition-all duration-300 hover:bg-white hover:shadow-[var(--ds-accent)]/30 focus:outline-none focus:ring-2 focus:ring-[var(--ds-accent)] focus:ring-offset-2 focus:ring-offset-[var(--ds-bg)]"
            >
              <span>Conocer Donatio SaaS</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h4a.75.75 0 010 1.5h-4z" clip-rule="evenodd" />
                <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.156 8.497a.75.75 0 00-.053 1.06z" clip-rule="evenodd" />
              </svg>
            </a>
            <a
              href="#casos"
              class="inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-[var(--ds-muted)] hover:text-white transition-colors py-2"
            >
              <span>Ver caso de estudio en DarkoSync</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right: The Complete Financial Infrastructure UI (From Pitch Video) -->
        <div class="lg:col-span-6">
          <div class="relative mx-auto w-full max-w-lg rounded-2xl border border-[var(--ds-border)] bg-[#07090C] p-5 sm:p-6 shadow-2xl">
            
            <!-- Window Navigation Bar -->
            <div class="flex items-center justify-between border-b border-[var(--ds-border)] pb-3 mb-5">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-[#EF4444]/80"></span>
                <span class="h-3 w-3 rounded-full bg-[#F59E0B]/80"></span>
                <span class="h-3 w-3 rounded-full bg-[#10B981]/80"></span>
                <span class="ml-2 font-mono text-[11px] text-[var(--ds-muted)]">
                  donatio.darkosync.com
                </span>
              </div>
              <div class="flex items-center gap-1.5 rounded-full border border-[var(--ds-accent)]/30 bg-[var(--ds-accent-dim)] px-2.5 py-0.5 text-[10px] font-mono font-bold text-[var(--ds-accent)]">
                <span class="h-1.5 w-1.5 rounded-full bg-[var(--ds-accent)] animate-pulse"></span>
                Cybersource 3DS2 · ATC
              </div>
            </div>

            <!-- Dashboard Highlights Bar -->
            <div class="grid grid-cols-3 gap-2 mb-5">
              <div class="rounded-lg border border-white/5 bg-[#0C0F12] p-2.5 text-center">
                <span class="block text-[9px] font-semibold uppercase tracking-wider text-[var(--ds-muted)]">Modalidad</span>
                <span class="text-xs font-bold text-white font-mono">Débito Mensual</span>
              </div>
              <div class="rounded-lg border border-white/5 bg-[#0C0F12] p-2.5 text-center">
                <span class="block text-[9px] font-semibold uppercase tracking-wider text-[var(--ds-muted)]">Moneda</span>
                <span class="text-xs font-bold text-[var(--ds-accent)] font-mono">Bs. / USD</span>
              </div>
              <div class="rounded-lg border border-white/5 bg-[#0C0F12] p-2.5 text-center">
                <span class="block text-[9px] font-semibold uppercase tracking-wider text-[var(--ds-muted)]">Normativa</span>
                <span class="text-xs font-bold text-white font-mono">UIF & Ley 393</span>
              </div>
            </div>

            <!-- Video Step 1: Recurring Subscription Checkout Simulation -->
            <div class="rounded-xl border border-[var(--ds-border)] bg-[#0C0F12] p-5 flex flex-col gap-4">
              
              <!-- Frequency Mode Selector -->
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--ds-muted)] block mb-2">
                  Frecuencia de Aporte
                </span>
                <div class="grid grid-cols-2 gap-2">
                  <div class="rounded-lg border-2 border-[var(--ds-accent)] bg-[var(--ds-accent-dim)] p-2.5 flex items-center justify-between">
                    <div>
                      <span class="block text-xs font-bold text-white">Mensual</span>
                      <span class="text-[10px] text-[var(--ds-accent)]">Se cobrará cada mes automáticamente</span>
                    </div>
                    <span class="h-2 w-2 rounded-full bg-[var(--ds-accent)]"></span>
                  </div>
                  <div class="rounded-lg border border-white/5 bg-white/5 p-2.5 flex items-center justify-between opacity-60">
                    <div>
                      <span class="block text-xs font-medium text-white">Una sola vez</span>
                      <span class="text-[10px] text-[var(--ds-muted)]">Cobro único al momento</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Padrino Tiers & Currency Switcher -->
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--ds-muted)]">
                    Monto de la Donación
                  </span>
                  <span class="rounded bg-white/10 px-2 py-0.5 text-[10px] font-mono text-white">
                    Bs. / USD
                  </span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div class="rounded-lg border border-white/10 bg-white/5 p-2.5 text-center">
                    <span class="block text-[9px] uppercase tracking-wider text-[var(--ds-muted)]">Benefactor</span>
                    <span class="text-xs font-bold text-white">100 Bs</span>
                  </div>
                  <div class="rounded-lg border-2 border-[var(--ds-accent)] bg-[var(--ds-accent)]/15 p-2.5 text-center shadow-sm">
                    <span class="block text-[9px] uppercase tracking-wider text-[var(--ds-accent)] font-semibold">Padrino</span>
                    <span class="text-xs font-extrabold text-[var(--ds-accent)]">500 Bs</span>
                  </div>
                  <div class="rounded-lg border border-white/10 bg-white/5 p-2.5 text-center">
                    <span class="block text-[9px] uppercase tracking-wider text-[var(--ds-muted)]">Exterior</span>
                    <span class="text-xs font-bold text-white">USD 35</span>
                  </div>
                </div>
              </div>

              <!-- 3DS2 Cybersource Security Badge -->
              <div class="rounded-lg border border-[var(--ds-accent)]/20 bg-[var(--ds-accent)]/5 p-3 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded bg-[var(--ds-accent)] text-black font-bold text-xs">
                    🔒
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-white">Verificación 3D Secure 2 (OTP SMS)</span>
                    <span class="text-[10px] text-[var(--ds-muted)]">Cybersource Cardinal Cruise · Autorización bancaria oficial</span>
                  </div>
                </div>
                <span class="rounded bg-black/40 px-2 py-0.5 text-[9px] font-mono text-[var(--ds-accent)]">
                  3DS2 OK
                </span>
              </div>

              <!-- Video Step 2: Instant Receipt with QR -->
              <div class="rounded-xl border border-white/10 bg-[#07090C] p-3.5 shadow-xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/10 p-1">
                    <svg class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M4 4h4v4H4V4zm2 2h0v0H6V6zm8-2h4v4h-4V4zm2 2h0v0h0V6zM4 14h4v4H4v-4zm2 2h0v0H6v-0zm6-1h2v2h-2v-2zm4 0h4v4h-4v-4zm2 2h0v0h0v-0zm-6 4h4v2h-4v-2zm-2-6h2v2h-2v-2z" />
                    </svg>
                  </div>
                  <div>
                    <span class="block text-xs font-bold text-white">Comprobante Digital con Código QR</span>
                    <span class="text-[10px] text-[var(--ds-muted)]">Verificable en línea · Firma digital institucional</span>
                  </div>
                </div>
                <span class="rounded bg-[var(--ds-accent)]/20 px-2 py-1 text-[10px] font-bold text-[var(--ds-accent)]">
                  PDF Emitido
                </span>
              </div>

              <!-- Video Step 3: Legal & UIF Regulatory Compliance -->
              <div class="rounded-lg border border-[#F59E0B]/30 bg-[#F59E0B]/5 p-3 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="text-sm">🛡️</span>
                  <div>
                    <span class="block text-xs font-bold text-white">Tranquilidad Legal y Bancaria UIF</span>
                    <span class="text-[10px] text-[var(--ds-muted)]">Umbrales Ley 393 & 62 · Reportes oficiales ROE en 1 clic</span>
                  </div>
                </div>
                <span class="rounded bg-[#F59E0B]/20 px-2 py-0.5 text-[9px] font-mono font-bold text-[#F59E0B]">
                  ROE EXPORT
                </span>
              </div>

            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>
